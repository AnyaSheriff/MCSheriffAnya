      "cmd": "summon zombie $(2.5,0,3.5) {NoAI:1b,Silent:1b,Tags:[\"gear_drop_probe\",\"gear_zero\"],equipment:{feet:{id:\"minecraft:diamond_boots\",count:1}},drop_chances:{feet:0.0f}}"
    },
    {
      "after": 3,
      "cmd": "summon zombie $(5.5,0,3.5) {NoAI:1b,Silent:1b,Tags:[\"gear_drop_probe\",\"gear_one\"],equipment:{feet:{id:\"minecraft:diamond_boots\",count:1}},drop_chances:{feet:1.0f}}"
    },
    {
      "after": 6,
      "cmd": "summon zombie $(8.5,0,3.5) {NoAI:1b,Silent:1b,Tags:[\"gear_drop_probe\",\"gear_two\"],equipment:{feet:{id:\"minecraft:diamond_boots\",count:1}},drop_chances:{feet:2.0f}}"
    },
    {
      "after": 9,
      "cmd": "summon zombie $(11.5,0,3.5) {NoAI:1b,Silent:1b,Tags:[\"gear_drop_probe\",\"gear_item\"],equipment:{feet:{id:\"minecraft:diamond_boots\",count:1}},drop_chances:{feet:0.0f}}"
    },
    {
      "after": 12,
