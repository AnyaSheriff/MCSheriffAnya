{
  "name": "enchant-mob-equipment-drops",
  "about": "Проверка equipment/drop_chances 0/1/2, /item при нулевом шансе, Vanishing и armor stand. /kill и player attack отдельно.",
  "exclusive": true,
  "origin": [
    128,
    70,
    128
  ],
  "inventory": true,
  "item_components": true,
  "blocks": [],
  "setup": [
    "execute in minecraft:overworld run tp $(bot) $(8.5,0,10.5)",
    "difficulty normal",
    "gamemode survival $(bot)",
    "time set midnight",
    "effect give $(bot) instant_health 1 10 true",
    "kill @e[tag=gear_drop_probe]",
    "fill $(0,-1,0) $(20,-1,12) stone",
    "fill $(0,0,0) $(20,4,8) air",
    "!wait 10"
  ],
  "actions": [
