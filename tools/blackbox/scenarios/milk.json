{
 "name": "milk",
 "about": "Ведро молока: пьётся 32 такта, снимает все эффекты (скорость, скрытый голод), ведро возвращается.",
 "blocks": [],
 "setup": [
  "difficulty normal",
  "gamerule natural_health_regeneration false",
  "gamemode survival $(bot)",
  "clear $(bot)",
  "kill $(bot)",
  "!wait 20",
  "fill $(2,0,-70) $(4,3,4) minecraft:air",
  "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
  "tp $(bot) $(3.5,0,3.5)",
  "!stopfly",
  "!look 0 0",
  "give $(bot) minecraft:milk_bucket 1",
  "!hotbar 0",
  "!wait 10",
  "effect give $(bot) minecraft:speed 30 0",
  "effect give $(bot) minecraft:resistance 30 1 true",
  "!wait 25"
 ],
 "actions": [
  {
   "after": 0,
   "use": true
  }
 ],
 "record_ticks": 60,
 "cleanup": [
  "difficulty peaceful",
  "gamerule natural_health_regeneration true",
  "effect clear $(bot)",
  "gamemode creative $(bot)",
  "clear $(bot)",
  "!wait 4",
  "!startfly"
 ],
 "track_self": true,
 "item_components": true,
 "inventory": true
}
