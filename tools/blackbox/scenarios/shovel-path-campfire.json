{
  "name": "shovel-path-campfire",
  "about": "Лопата делает тропинку и тушит костёр, огниво зажигает обратно. [проверить], без запуска.",
  "track_self": true,
  "blocks": [
    {
      "at": [
        0,
        0,
        0
      ],
      "state": "minecraft:grass_block"
    },
    {
      "at": [
        2,
        0,
        0
      ],
      "state": "minecraft:campfire[lit=true]"
    }
  ],
  "setup": [
    "clear $(bot)",
    "gamemode survival $(bot)",
    "tp $(bot) $(0.5,0,2.5)",
    "!stopfly",
    "give $(bot) iron_shovel",
    "give $(bot) flint_and_steel",
    "!hotbar 0"
  ],
  "actions": [
    {
      "after": 0,
      "click": [
        0,
        0,
        0
      ]
    },
    {
      "after": 8,
      "click": [
        2,
        0,
        0
      ]
    },
    {
      "after": 16,
      "hotbar": 1
    },
    {
      "after": 18,
      "click": [
        2,
        0,
        0
      ]
    }
  ],
  "record_ticks": 70,
  "cleanup": [
    "clear $(bot)",
    "fill $(0,0,0) $(3,0,0) air",
    "gamemode creative $(bot)"
  ]
}
