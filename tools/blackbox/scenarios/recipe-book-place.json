{
  "name": "recipe-book-place",
  "about": "Recipe-book Place Recipe autofill and ghost when ingredients are absent. [unverified: record against vanilla 26.1.2]",
  "blocks": [],
  "setup": [
    "clear $(bot)",
    "tp $(bot) $(0.5,0,2.5) 180 0",
    "gamemode survival $(bot)",
    "!stopfly",
    "item replace entity $(bot) hotbar.0 with minecraft:oak_planks 8"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "!place_recipe crafting_table all"
    },
    {
      "after": 10,
      "window_click": {
        "inventory": true,
        "slot": 0,
        "button": 0,
        "mode": 1
      }
    },
    {
      "after": 20,
      "cmd": "!place_recipe crafting_table"
    },
    {
      "after": 30,
      "close": true,
      "inventory": true
    }
  ],
  "cleanup": [
    "fill $(-5,0,-5) $(5,5,5) minecraft:air",
    "kill @e[type=item,distance=..48]",
    "clear $(bot)",
    "gamemode creative $(bot)"
  ],
  "record_ticks": 55,
  "origin": [
    0,
    -59,
    0
  ],
  "inventory": true,
  "item_components": true,
  "track_self": true,
  "track_mobs": true
}
