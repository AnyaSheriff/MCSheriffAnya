{
  "name": "witch-bounded-near-2",
  "about": "Discovery only: boundary and guard observations; no predefined timing or selection parity",
  "track_mobs": true,
  "track_projectiles": true,
  "track_self": true,
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamemode survival $(bot)",
    "clear $(bot)",
    "effect clear $(bot)",
    "effect give $(bot) resistance 255 4 true",
    "tp $(bot) $(0.5,0,0.5)",
    "!stopfly",
    "!wait 10"
  ],
  "actions": [
    {
      "after": 10,
      "cmd": "summon witch $(2.5,0,0.5) {Silent:1b}"
    },
    {
      "after": 410,
      "cmd": "kill @e[type=witch,distance=..48]"
    }
  ],
  "record_ticks": 430,
  "cleanup": [
    "kill @e[type=witch,distance=..48]",
    "kill @e[type=splash_potion,distance=..48]",
    "effect clear $(bot)",
    "difficulty peaceful",
    "gamemode creative $(bot)",
    "!wait 4",
    "!startfly"
  ]
}
