{
  "name": "bedrock-beacon-shared",
  "about": "Shared beacon actor and effects; observer fixture. Bedrock payment and rejection additionally require interactive client verification.",
  "origin": [
    0,
    100,
    0
  ],
  "blocks": [],
  "track_self": true,
  "inventory": true,
  "setup": [
    "gamemode survival $(bot)",
    "clear $(bot)",
    "fill $(-2,-1,-2) $(12,-1,12) minecraft:stone",
    "fill $(1,-1,1) $(3,-1,3) minecraft:iron_block",
    "setblock $(2,0,2) minecraft:beacon",
    "tp $(bot) $(2.5,0,0.5)",
    "give $(bot) minecraft:emerald 2",
    "!wait 20"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "data merge block $(2,0,2) {primary_effect:\"minecraft:speed\"}"
    },
    {
      "after": 10,
      "click": [
        2,
        0,
        2
      ],
      "face": 2
    },
    {
      "after": 20,
      "window_click": {
        "slot": 28,
        "button": 0,
        "mode": 1
      }
    },
    {
      "after": 30,
      "close": true
    },
    {
      "after": 90,
      "set": {
        "at": [
          2,
          2,
          2
        ],
        "state": "minecraft:stone"
      }
    }
  ],
  "record_ticks": 180,
  "cleanup": [
    "clear $(bot)",
    "effect clear $(bot)",
    "gamemode creative $(bot)",
    "fill $(-2,-1,-2) $(12,6,12) minecraft:air"
  ]
}
