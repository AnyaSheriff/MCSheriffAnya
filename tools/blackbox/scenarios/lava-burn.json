  "random": [
    {
      "type": "mask",
      "kind": "self",
      "name": "место возрождения",
      "pattern": "\\(-?[\\d.]+,-?[\\d.]+,-?[\\d.]+\\)",
      "replace": "(место)",
      "why": "Игрок без кровати возрождается в случайной точке вокруг точки появления мира (minecraft.wiki/w/Respawn, «Spawn radius»: gamerule spawnRadius, по умолчанию 10); оригинал против оригинала: (-3.5,-60,-8.5), (5.5,-59,2.5), (6.5,-60,3.5)."
    },
    {
      "type": "mask",
      "kind": "sv",
      "name": "высота точки появления",
      "pattern": "\"location\":\\{\"x\":0,\"z\":0,\"y\":-?\\d+\\}",
      "replace": "\"location\":{точка}",
      "why": "У нашего испытательного ровного мира точка появления считается по высоте обычного мира (63), а у оригинала — по плоскому (−60): расхождение испытательного мира, а не механики."
    },
    {
      "type": "count",
      "name": "список атрибутов при возрождении",
      "match": "^sv Attributes \\[\\{\"key\":\"generic\\.[a-z_]+\",\"value\":[0-9.]+,\"modifiers\":\\[\\]\\}",
      "range": [
        0,
        2
      ],
      "anytick": true,
      "why": "при возрождении оригинал шлёт все атрибуты, что когда-либо заводились у игрока (они лежат в его файле на сервере): у робота blackbox список короткий (5 записей), у blackbox4 — длинный (luck, max_absorption и др.); замер оригинал против оригинала: записи 1–3 (полоса 1) и 4–6 (полоса 4) отличаются составом списка"
    }
  ],
  "track_self": true
}
