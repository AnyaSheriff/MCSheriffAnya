{
 "about": "Лодку бьют мечом (урон 7 → 70 > 40): ломается с первого удара, выпадает предмет; потом ещё удар рукой по воздуху.",
 "track_mobs": true,
 "track_self": true,
 "blocks": [],
 "setup": [
  "difficulty normal",
  "gamemode survival $(bot)",
  "clear $(bot)",
  "kill $(bot)",
  "!wait 20",
  "tp $(bot) $(3.5,2,-1.5) 0 50",
  "!wait 20",
  "fill $(-1,0,-1) $(7,6,7) minecraft:air",
  "fill $(0,0,0) $(6,1,6) minecraft:stone",
  "fill $(1,0,1) $(5,1,5) minecraft:water",
  "tp $(bot) $(3.5,2,0.5) 0 20",
  "give $(bot) minecraft:diamond_sword 1",
  "!stopfly",
  "!hotbar 0",
  "summon minecraft:oak_boat $(3.5,1.9,2.5)",
  "!wait 40"
 ],
 "actions": [
  {
   "after": 0,
   "attack": true
  },
  {
   "after": 30,
   "cmd": "tp $(bot) $(3.5,2,0.5) 0 20"
  }
 ],
 "record_ticks": 60,
 "cleanup": [
  "kill @e[type=!player,distance=..48]",
  "fill $(0,0,0) $(6,1,6) minecraft:air",
  "fill $(-1,0,-1) $(7,6,7) minecraft:air",
  "gamemode creative $(bot)",
  "clear $(bot)"
 ],
 "name": "boat-break"
}