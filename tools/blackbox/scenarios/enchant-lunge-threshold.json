    "clear $(bot)",
    "gamemode survival $(bot)",
    "effect give $(bot) instant_health 1 10 true",
    "effect give $(bot) saturation 1 10 true",
    "!hotbar 0",
    "fill $(-3,0,-3) $(3,5,30) air",
    "fill $(-3,-1,-3) $(3,-1,30) stone",
    "tp $(bot) $(0.5,0,0.5) 0 0",
    "!stopfly",
    "!look 0 0",
    "item replace entity $(bot) weapon.mainhand with iron_spear[enchantments={lunge:1}]",
    "!wait 25"
