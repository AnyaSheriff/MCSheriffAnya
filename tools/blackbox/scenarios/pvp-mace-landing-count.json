{
  "name": "pvp-mace-landing-count",
  "about": "[проверить] Smash landing particle count at several hit heights. Records separate hits after cooldown; distinguishes height/count formulas from the two known points (105 and cap 200).",
  "second": true,
  "track_self": true,
  "track_players": true,
  "exclusive": true,
  "blocks": [],
  "track_second": true,
  "setup": [
    "difficulty normal",
    "gamerule natural_health_regeneration false",
    "gamemode survival $(bot)",
    "gamemode survival $(bot2)",
    "clear $(bot)",
    "clear $(bot2)",
    "kill $(bot)",
    "!wait 30",
    "give $(bot2) minecraft:mace 1",
    "tp $(bot) $(3.5,0,3.5) 180 0",
    "tp $(bot2) $(3.5,0,1.5) 0 0",
    "!stopfly",
    "!wait 20",
    "!hotbar2 0",
    "!hotbar 0",
    "fill $(-2,-1,-2) $(7,-1,7) stone",
    "fill $(-2,0,-2) $(7,12,7) air",
    "attribute $(bot) minecraft:max_health base set 200",
    "effect give $(bot) instant_health 1 10"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "effect give $(bot) instant_health 1 10"
    },
    {
      "after": 0,
