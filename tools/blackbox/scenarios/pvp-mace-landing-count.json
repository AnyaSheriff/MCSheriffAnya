  "record_ticks": 240,
  "cleanup": [
    "attribute $(bot) minecraft:max_health base reset",
    "kill @e[type=cow,distance=..48]",
    "kill @e[type=item,distance=..48]",
    "kill @e[type=arrow,distance=..48]",
    "difficulty peaceful",
    "gamerule natural_health_regeneration true",
    "gamemode creative $(bot)",
    "gamemode creative $(bot2)",
    "clear $(bot)",
    "clear $(bot2)",
    "tp $(bot2) $(6.5,0,6.5)",
    "!wait 4",
    "!startfly",
    "fill $(-2,-1,-2) $(7,12,7) air"
  ],
  "item_components": true,
  "track_second_velocity": true,
  "random": [
    {
      "type": "mask",
      "name": "насыщение ударившего после паузы",
      "kind": "sv",
      "pattern": "(b: Set Health health=[0-9.H]+ food=\\d+ saturation=)\\d+",
      "replace": "$1S",
      "why": "насыщение второго робота копится в мирной паузе между сценариями (+1 раз в 20 тактов, peaceful-saturation-probe) и зависит от длины паузы: у оригинала 17–20 от прогона к прогону, у нас 16–20"
    }
  ]
