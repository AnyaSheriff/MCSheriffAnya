    },
    {
      "after": 0,
      "cmd": "tp $(bot2) $(3.5,4,1.5) 0 0"
    },
    {
      "after": 7,
      "attack": true,
      "bot": 2
    },
    {
      "after": 60,
      "cmd": "effect give $(bot) instant_health 1 10"
    },
    {
      "after": 60,
      "cmd": "tp $(bot) $(3.5,0,3.5) 180 0"
    },
    {
      "after": 60,
      "cmd": "tp $(bot2) $(3.5,5,1.5) 0 0"
    },
    {
      "after": 67,
      "attack": true,
      "bot": 2
    },
    {
      "after": 120,
      "cmd": "effect give $(bot) instant_health 1 10"
    },
    {
      "after": 120,
      "cmd": "tp $(bot) $(3.5,0,3.5) 180 0"
    },
    {
      "after": 120,
      "cmd": "tp $(bot2) $(3.5,6,1.5) 0 0"
    },
    {
      "after": 127,
      "attack": true,
      "bot": 2
    },
    {
      "after": 180,
