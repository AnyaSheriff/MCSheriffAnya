{
  "name": "axolotl-play-dead",
  "about": "[проверить] Nonlethal entity damage to an underwater axolotl may trigger play dead and Regeneration. Repeated vanilla runs are required.",
  "track_mobs": true,
  "track_self": true,
  "exclusive": true,
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "tp $(bot) $(3.5,1,6.5)",
    "!wait 5",
    "fill $(0,-1,0) $(7,2,7) minecraft:stone",
    "fill $(1,0,1) $(6,2,6) minecraft:air",
    "fill $(1,0,1) $(6,1,6) minecraft:water"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "summon axolotl $(3.5,0,3.5) {Silent:1b,Variant:4,Health:8f}"
    },
    {
      "after": 10,
      "cmd": "damage @e[type=axolotl,limit=1,distance=..16] 2 minecraft:player_attack by $(bot)"
    },
    {
      "after": 35,
      "cmd": "damage @e[type=axolotl,limit=1,distance=..16] 2 minecraft:player_attack by $(bot)"
    }
  ],
  "record_ticks": 260,
  "cleanup": [
    "gamemode creative $(bot)",
    "tp $(bot) $(3.5,3,6.5)",
    "!startfly",
    "kill @e[type=cod,distance=..48]",
    "kill @e[type=salmon,distance=..48]",
    "kill @e[type=tropical_fish,distance=..48]",
    "kill @e[type=pufferfish,distance=..48]",
    "kill @e[type=squid,distance=..48]",
    "kill @e[type=glow_squid,distance=..48]",
    "kill @e[type=dolphin,distance=..48]",
    "kill @e[type=turtle,distance=..48]",
    "kill @e[type=axolotl,distance=..48]",
    "kill @e[type=frog,distance=..48]",
    "kill @e[type=tadpole,distance=..48]",
    "kill @e[type=slime,distance=..48]",
    "kill @e[type=magma_cube,distance=..48]",
    "kill @e[type=item,distance=..48]",
    "kill @e[type=experience_orb,distance=..48]",
    "fill $(0,-1,0) $(7,2,7) minecraft:air",
    "fill $(0,-1,0) $(7,-1,7) minecraft:stone",
    "clear $(bot)",
    "effect clear $(bot)",
    "difficulty peaceful",
    "time set noon"
  ],
  "random": [
    {
      "type": "count",
      "name": "плавание аксолотля",
      "match": "^cart axolotl ",
      "range": [
        0,
        400
      ],
      "anytick": true,
      "why": "аксолотль свободно плавает по случайным целям: путь, скорость и повороты случайны"
    }
  ]
}