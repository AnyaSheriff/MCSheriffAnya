{
  "name": "frog-eat-slime",
  "about": "[проверить] Frog hunts a small slime then a small magma cube; eating a cube produces the variant-specific froglight.",
  "track_mobs": true,
  "track_self": true,
  "exclusive": true,
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "tp $(bot) $(3.5,1,6.5)",
    "!wait 5",
    "fill $(0,-1,0) $(7,2,7) minecraft:stone",
    "fill $(1,0,1) $(6,2,6) minecraft:air"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "summon frog $(3.5,0,3.5) {Silent:1b,variant:\"minecraft:temperate\"}"
    },
    {
      "after": 1,
      "cmd": "summon slime $(3.5,0,4.5) {Size:0,NoAI:1b,Silent:1b}"
    },
    {
      "after": 160,
      "cmd": "summon magma_cube $(3.5,0,4.5) {Size:0,NoAI:1b,Silent:1b}"
    }
  ],
  "record_ticks": 400,
  "cleanup": [
    "gamemode creative $(bot)",
    "tp $(bot) $(3.5,3,6.5)",
    "!startfly",
    "kill @e[type=cod,distance=..48]",
    "kill @e[type=salmon,distance=..48]",
    "kill @e[type=tropical_fish,distance=..48]",
    "kill @e[type=pufferfish,distance=..48]",
    "kill @e[type=squid,distance=..48]",
    "kill @e[type=glow_squid,distance=..48]",
    "kill @e[type=dolphin,distance=..48]",
    "kill @e[type=turtle,distance=..48]",
    "kill @e[type=axolotl,distance=..48]",
    "kill @e[type=frog,distance=..48]",
    "kill @e[type=tadpole,distance=..48]",
    "kill @e[type=slime,distance=..48]",
    "kill @e[type=magma_cube,distance=..48]",
    "kill @e[type=item,distance=..48]",
    "kill @e[type=experience_orb,distance=..48]",
    "fill $(0,-1,0) $(7,2,7) minecraft:air",
    "fill $(0,-1,0) $(7,-1,7) minecraft:stone",
    "clear $(bot)",
    "effect clear $(bot)",
    "difficulty peaceful",
    "time set noon"
  ],
  "random": [
    {
      "type": "mask",
      "name": "номер цели языка",
      "kind": "meta",
      "pattern": "^meta 6=9 19=\\d+$",
      "replace": "meta 6=9 19=ID",
      "why": "в свойстве 19 — номер сущности-цели, его назначает сервер"
    },
    {
      "type": "count",
      "name": "кваканье",
      "match": "^meta 6=(0|8)$",
      "range": [
        0,
        14
      ],
      "anytick": true,
      "why": "лягушка квакает (поза 8) в случайные моменты и на случайный срок"
    },
    {
      "type": "count",
      "name": "ходьба лягушки",
      "match": "^cart frog ",
      "range": [
        0,
        120
      ],
      "anytick": true,
      "why": "лягушка между охотами прыгает по случайным точкам"
    },
    {
      "type": "delay",
      "name": "задержка языка",
      "from": "^spawn .* (slime|magma_cube) ",
      "to": "frog.tongue",
      "range": [
        28,
        115
      ],
      "why": "лягушка стреляет языком через случайный срок после появления цели: 60, 106 и 34 такта в трёх записях оригинала"
    }
  ]
}