{
  "name": "itemaudit4-mending",
  "about": "[проверить] Mending: orb 7 XP при двух вещах damage=3 — проверить передачу остатка другой вещи, итоговый износ обеих и опыт игрока.",
  "blocks": [],
  "setup": [
    "gamemode creative $(bot)",
    "execute in minecraft:overworld run tp $(bot) $(3.5,0,3.5)",
    "!wait 10",
    "difficulty peaceful",
    "clear $(bot)",
    "effect clear $(bot)",
    "attribute $(bot) minecraft:scale base set 1",
    "attribute $(bot) minecraft:step_height base set 0.6",
    "attribute $(bot) minecraft:safe_fall_distance base set 3",
    "attribute $(bot) minecraft:max_health base set 20",
    "xp set $(bot) 0 levels",
    "xp set $(bot) 0 points",
    "fill $(-2,0,-2) $(8,3,8) minecraft:air",
    "fill $(-2,-1,-2) $(8,-1,8) minecraft:stone",
    "kill @e[type=experience_orb,distance=..48]",
    "tp $(bot) $(3.5,0,3.5)",
    "gamemode survival $(bot)",
    "effect give $(bot) instant_health 1 10 true",
    "!stopfly",
    "!wait 20",
    "item replace entity $(bot) weapon.offhand with minecraft:diamond_sword[damage=3,enchantments={\"minecraft:mending\":1}]",
    "item replace entity $(bot) armor.head with diamond_helmet[damage=3,enchantments={\"minecraft:mending\":1}]",
    "!wait 5"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "summon minecraft:experience_orb $(3.5,0.5,5.5) {Value:7s}"
    }
  ],
  "record_ticks": 60,
  "cleanup": [
    "kill @e[type=minecraft:experience_orb,distance=..12]",
    "xp set $(bot) 0 levels",
    "xp set $(bot) 0 points",
    "difficulty peaceful",
    "gamemode creative $(bot)",
    "!wait 4",
    "!startfly",
    "clear $(bot)",
    "kill @e[type=item,distance=..48]"
  ],
  "track_self": true,
  "item_components": true,
  "inventory": true,
  "exclusive": true,
  "origin": [
    128,
    70,
    128
  ]
}
