{
 "name": "bundle-chest-select",
 "about": "Bundle in a chest window: left click inserts (bundle on cursor + item, item on cursor + bundle), 64 weight limit, selection (select_bundle_item), right click extracts the selected / newest stack, use in hand throws one group.",
 "blocks": [
  { "at": [0, 0, 0], "state": "minecraft:chest[facing=south]" }
 ],
 "setup": [
  "clear $(bot)",
  "tp $(bot) $(0.5,0,2.5) 180 0",
  "gamemode survival $(bot)",
  "!stopfly",
  "give $(bot) minecraft:bundle",
  "give $(bot) minecraft:ender_pearl 10",
  "give $(bot) minecraft:stone 40"
 ],
 "actions": [
  { "after": 0, "click": [0, 0, 0], "face": 1 },
  { "after": 10, "window_click": { "slot": 54, "button": 0, "mode": 0 } },
  { "after": 20, "window_click": { "slot": 55, "button": 0, "mode": 0 } },
  { "after": 30, "window_click": { "slot": 56, "button": 0, "mode": 0 } },
  { "after": 40, "window_click": { "slot": 54, "button": 0, "mode": 0 } },
  { "after": 50, "raw": { "name": "select_bundle_item", "params": { "slotId": 54, "selectedItemIndex": 1 } } },
  { "after": 60, "window_click": { "slot": 54, "button": 1, "mode": 0 } },
  { "after": 70, "window_click": { "slot": 57, "button": 0, "mode": 0 } },
  { "after": 80, "window_click": { "slot": 54, "button": 1, "mode": 0 } },
  { "after": 90, "window_click": { "slot": 58, "button": 0, "mode": 0 } },
  { "after": 100, "window_click": { "slot": 57, "button": 0, "mode": 0 } },
  { "after": 110, "window_click": { "slot": 56, "button": 0, "mode": 0 } },
  { "after": 120, "close": true },
  { "after": 130, "use": true }
 ],
 "cleanup": [
  "fill $(-5,0,-5) $(5,5,5) minecraft:air",
  "kill @e[type=item,distance=..48]",
  "clear $(bot)",
  "gamemode creative $(bot)"
 ],
 "record_ticks": 170,
 "origin": [0, -59, 0],
 "item_components": true,
 "track_self": true,
 "track_mobs": true
}
