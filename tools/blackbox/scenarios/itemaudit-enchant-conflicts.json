{
  "name": "itemaudit-enchant-conflicts",
  "about": "[проверить] Команда enchant запрещает Smite на mace с принудительным Impaling. Lunge и Mending на spear совместимы в 26.1.2. Не запускался.",
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamerule natural_health_regeneration false",
    "gamemode survival $(bot)",
    "clear $(bot)",
    "kill $(bot)",
    "!wait 20",
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "tp $(bot) $(3.5,0,3.5)",
    "!stopfly",
    "!look 0 0",
    "!hotbar 0",
    "!wait 10",
    "!wait 25",
    "give $(bot) mace[enchantments={impaling:1}]"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "enchant $(bot) smite 1"
    },
    {
      "after": 5,
      "cmd": "item replace entity $(bot) weapon.mainhand with iron_spear[enchantments={lunge:3}]"
    },
    {
      "after": 10,
      "cmd": "enchant $(bot) mending 1"
    }
  ],
  "record_ticks": 20,
  "cleanup": [
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "difficulty peaceful",
    "gamerule natural_health_regeneration true",
    "effect clear $(bot)",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "!wait 4",
    "!startfly",
    "kill @e[type=item,distance=..48]"
  ],
  "track_self": true,
  "item_components": true,
  "inventory": true,
  "exclusive": true
}
