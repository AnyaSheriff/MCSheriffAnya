{
  "name": "perf-tracker-snapshot",
  "about": "[проверить] Снимок слежения: NoAI-корова, переносы и смена возраста на заданных тактах. Регрессия оптимизации снимка; без послаблений номера такта.",
  "exclusive": true,
  "origin": [
    100,
    5,
    100
  ],
  "track_mobs": true,
  "blocks": [],
  "setup": [
    "gamemode creative $(bot)",
    "fill $(0,-1,0) $(8,-1,8) minecraft:stone",
    "tp $(bot) $(1.5,0,1.5)"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "summon cow $(3.5,0,3.5) {NoAI:1b,Silent:1b,Tags:[\"perf_snapshot\"]}"
    },
    {
      "after": 10,
      "cmd": "tp @e[tag=perf_snapshot,limit=1] $(5.5,0,3.5)"
    },
    {
      "after": 20,
      "cmd": "data merge entity @e[tag=perf_snapshot,limit=1] {Age:-24000}"
    },
    {
      "after": 30,
      "cmd": "tp @e[tag=perf_snapshot,limit=1] $(3.5,0,5.5)"
    },
    {
      "after": 40,
      "cmd": "data merge entity @e[tag=perf_snapshot,limit=1] {Age:0}"
    }
  ],
  "record_ticks": 75,
  "cleanup": [
    "kill @e[tag=perf_snapshot]",
    "kill @e[type=item,distance=..48]",
    "kill @e[type=experience_orb,distance=..48]",
    "fill $(0,-1,0) $(8,4,8) minecraft:air"
  ]
}
