{
  "name": "composter-hoppers",
  "about": "Воронка сверху вносит пироги; снизу забирает одну костную муку; боковая не вносит. [проверить], без запуска.",
  "blocks": [
    {
      "at": [
        0,
        0,
        0
      ],
      "state": "minecraft:composter"
    },
    {
      "at": [
        0,
        1,
        0
      ],
      "state": "minecraft:hopper[facing=down]"
    },
    {
      "at": [
        0,
        -1,
        0
      ],
      "state": "minecraft:hopper[facing=down]"
    },
    {
      "at": [
        1,
        0,
        0
      ],
      "state": "minecraft:hopper[facing=west]"
    }
  ],
  "setup": [
    "clear $(bot)",
    "gamemode survival $(bot)",
    "tp $(bot) $(0.5,0,2.5)",
    "!stopfly"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "item replace block $(0,1,0) container.0 with pumpkin_pie 7"
    },
    {
      "after": 2,
      "cmd": "item replace block $(1,0,0) container.0 with cake"
    }
  ],
  "record_ticks": 110,
  "cleanup": [
    "gamerule random_tick_speed 3",
    "clear $(bot)",
    "fill $(-1,-1,-1) $(8,20,1) air",
    "kill @e[type=item,distance=..12]",
    "gamemode creative $(bot)",
    "fill $(-1,-1,-1) $(8,-1,1) stone"
  ]
}
