{
 "name": "painting-variants",
 "about": "Paintings placed on a 1x1, a 2x1 and a 1x2 wall: which variants fit (variant id shown in entity metadata). Random pick among fitting variants is judged by vanilla-vs-vanilla runs.",
 "blocks": [
  { "at": [-2, 1, 0], "state": "minecraft:stone" },
  { "at": [0, 1, 0], "state": "minecraft:stone" },
  { "at": [1, 1, 0], "state": "minecraft:stone" },
  { "at": [3, 1, 0], "state": "minecraft:stone" },
  { "at": [3, 2, 0], "state": "minecraft:stone" }
 ],
 "setup": [
  "kill @e[type=painting,distance=..48]",
  "clear $(bot)",
  "tp $(bot) $(0.5,0,2.5) 180 0",
  "gamemode survival $(bot)",
  "!stopfly",
  "give $(bot) minecraft:painting 3"
 ],
 "actions": [
  { "after": 0, "click": [-2, 1, 0], "face": 3 },
  { "after": 10, "click": [0, 1, 0], "face": 3 },
  { "after": 20, "click": [3, 1, 0], "face": 3 }
 ],
 "cleanup": [
  "kill @e[type=painting,distance=..48]",
  "fill $(-5,0,-5) $(5,5,5) minecraft:air",
  "kill @e[type=item,distance=..48]",
  "clear $(bot)",
  "gamemode creative $(bot)"
 ],
 "record_ticks": 50,
 "origin": [0, -59, 0],
 "item_components": true,
 "track_self": true,
 "track_mobs": true
}
