  },
  {
   "after": 38,
   "raw": {
    "name": "player_input",
    "params": {
     "inputs": {
      "forward": false,
      "backward": false,
      "left": false,
      "right": false,
      "jump": false,
      "shift": false,
      "sprint": false
     }
    }
   }
  },
  {
   "after": 45,
