{
  "name": "itemaudit2-totem-hands",
  "about": "[проверить] Тотем сперва расходуется из mainhand, затем offhand; его Fire Resistance защищает от лавы. Не запускался.",
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamerule natural_health_regeneration false",
    "gamemode survival $(bot)",
    "clear $(bot)",
    "kill $(bot)",
    "!wait 20",
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "tp $(bot) $(3.5,0,3.5)",
    "!stopfly",
    "!look 0 0",
    "!hotbar 0",
    "!wait 10",
    "!wait 25",
    "item replace entity $(bot) weapon.offhand with minecraft:totem_of_undying 1",
    "effect give $(bot) poison 60",
    "item replace entity $(bot) weapon.mainhand with minecraft:totem_of_undying 1"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "damage $(bot) 100 minecraft:generic"
    },
    {
      "after": 25,
      "cmd": "damage $(bot) 100 minecraft:lava"
    },
    {
      "after": 50,
      "cmd": "damage $(bot) 100 minecraft:generic"
    }
  ],
  "record_ticks": 90,
  "cleanup": [
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "difficulty peaceful",
    "gamerule natural_health_regeneration true",
    "effect clear $(bot)",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "!wait 4",
    "!startfly",
    "kill @e[type=item,distance=..48]",
    "effect clear $(bot)",
    "fill $(3,0,3) $(3,2,3) air"
  ],
  "track_self": true,
  "item_components": true,
  "inventory": true,
  "exclusive": true
}
