{
  "name": "itemaudit-hidden-effects",
  "about": "[проверить] Speed I 10 s скрывается под Speed II 2 s; после 40 ticks возвращается с оставшимся сроком. Milk очищает и скрытые эффекты. Не запускался.",
  "second": true,
  "track_self": true,
  "track_players": true,
  "exclusive": true,
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamerule natural_health_regeneration false",
    "gamemode survival $(bot)",
    "gamemode survival $(bot2)",
    "clear $(bot)",
    "clear $(bot2)",
    "kill $(bot)",
    "!wait 30",
    "tp $(bot) $(3.5,0,3.5) 180 0",
    "tp $(bot2) $(3.5,0,1.5) 0 0",
    "!stopfly",
    "!wait 20",
    "!hotbar2 0",
    "!hotbar 0",
    "give $(bot) milk_bucket"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "effect give $(bot) speed 10 0"
    },
    {
      "after": 5,
      "cmd": "effect give $(bot) speed 2 1"
    },
    {
      "after": 55,
      "cmd": "effect give $(bot) speed 10 2"
    },
    {
      "after": 60,
      "cmd": "effect give $(bot) speed 20 0"
    },
    {
      "after": 65,
      "use": true
    }
  ],
  "record_ticks": 140,
  "cleanup": [
    "kill @e[type=cow,distance=..48]",
    "kill @e[type=item,distance=..48]",
    "kill @e[type=arrow,distance=..48]",
    "difficulty peaceful",
    "gamerule natural_health_regeneration true",
    "gamemode creative $(bot)",
    "gamemode creative $(bot2)",
    "clear $(bot)",
    "clear $(bot2)",
    "tp $(bot2) $(6.5,0,6.5)",
    "!wait 4",
    "!startfly",
    "effect clear $(bot)",
    "effect clear $(bot2)"
  ],
  "item_components": true,
  "track_second": true
}
