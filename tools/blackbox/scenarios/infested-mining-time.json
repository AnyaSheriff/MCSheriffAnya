{
  "name": "infested-mining-time",
  "about": "Измерение: за сколько тактов оригинал принимает «докопал» (status 2) для заражённого камня голой рукой. Цепочка попыток с растущей паузой между началом и концом копания.",
  "exclusive": true,
  "track_self": true,
  "blocks": [],
  "setup": [
    "difficulty peaceful",
    "gamemode survival $(bot)",
    "clear $(bot)",
    "tp $(bot) $(3.5,0,5.5)",
    "!stopfly",
    "!wait 10"
  ],
  "actions": [
