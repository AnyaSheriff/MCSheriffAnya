{
 "name": "rabbit-hit",
 "about": "Кролик NoAI: три удара кулаком (3 здоровья, неуязвимость 10 тактов), звуки урона и смерти, добыча.",
 "exclusive": true,
 "track_mobs": true,
 "blocks": [],
 "setup": [
  "difficulty normal",
  "gamemode survival $(bot)",
  "effect clear $(bot)",
  "clear $(bot)",
  "tp $(bot) $(3.5,0,0.5)",
  "!stopfly",
  "!wait 10",
  "!look 0 0"
 ],
 "actions": [
  {
   "after": 0,
   "cmd": "summon rabbit $(3.5,0,3.5) {NoAI:1b,RabbitType:1}"
  },
  {
   "after": 20,
   "attack": true
  },
  {
   "after": 36,
   "attack": true
  },
  {
   "after": 52,
   "attack": true
  }
 ],
 "record_ticks": 100,
 "cleanup": [
  "kill @e[type=rabbit,distance=..48]",
  "kill @e[type=fox,distance=..48]",
  "kill @e[type=bee,distance=..48]",
  "kill @e[type=item,distance=..48]",
  "kill @e[type=experience_orb,distance=..48]",
  "effect clear $(bot)",
  "gamerule natural_regeneration true",
  "gamerule random_tick_speed 3",
  "time set day",
  "difficulty peaceful",
  "gamemode creative $(bot)",
  "clear $(bot)",
  "!wait 4",
  "!startfly",
  "fill $(-8,0,-8) $(8,8,8) minecraft:air",
  "fill $(-8,-1,-8) $(8,-1,8) minecraft:stone"
 ],
 "random": [
  {
   "type": "count",
   "name": "голос в покое",
   "match": "entity\\.rabbit\\.ambient",
   "range": [
    0,
    3
   ],
   "anytick": true,
   "why": "вики, Sounds: голос в покое по случайному счёту; два прогона оригинала расходятся"
  },
  {
   "type": "count",
   "name": "число выпавших стопок",
   "match": "^spawn [-0-9,.]+ item|^spawn item",
   "range": [
    0,
    3
   ],
   "why": "вики, Rabbit: «Drops: 0–1 rabbit hide, 0–1 raw rabbit, rabbit's foot 10%»"
  },
  {
   "type": "mask",
   "name": "число предметов в стопке",
   "kind": "meta",
   "pattern": "\"itemCount\":\\d+",
   "replace": "\"itemCount\":N",
   "why": "вики, Rabbit: «Drops: 0–1 rabbit hide, 0–1 raw rabbit, rabbit's foot 10%»"
  },
  {
   "type": "count",
   "name": "свойства выпавших стопок",
   "match": "^meta 8=\\{",
   "range": [
    0,
    6
   ],
   "why": "вики, Rabbit: «Drops: 0–1 rabbit hide, 0–1 raw rabbit, rabbit's foot 10%»"
  },
  {
   "type": "count",
   "name": "ход выпавших предметов",
   "match": "^cart item",
   "range": [
    0,
    40
   ],
   "anytick": true,
   "why": "выпавший предмет получает случайный толчок"
  },
  {
   "type": "count",
   "name": "число шариков опыта",
   "match": "^spawn [-0-9,.]+ experience_orb",
   "range": [
    0,
    3
   ],
   "why": "вики, Rabbit: 1–3 очка опыта"
  },
  {
   "type": "count",
   "name": "свойства шариков опыта",
   "match": "^meta 8=\\d+$",
   "range": [
    0,
    6
   ],
   "why": "вики, Rabbit: 1–3 очка опыта"
  },
  {
   "type": "count",
   "name": "ход и подбор шариков опыта",
   "match": "^cart experience_orb",
   "range": [
    0,
    30
   ],
   "anytick": true,
   "why": "шарик получает случайный толчок при появлении"
  }
 ]
}