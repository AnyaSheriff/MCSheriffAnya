      "forward": false,
      "backward": false,
      "left": false,
      "right": false,
      "jump": false,
      "shift": true,
      "sprint": false
     }
    }
   }
  },
  {
   "after": 32,
   "raw": {
    "name": "player_input",
    "params": {
     "inputs": {
      "forward": false,
      "backward": false,
      "left": false,
      "right": false,
      "jump": false,
      "shift": false,
      "sprint": false
     }
    }
   }
  },
  {
   "after": 45,
   "interact": true
  },
  {
   "after": 90,
   "interact": true
  },
  {
   "after": 140,
   "interact": true
  }
 ],
 "record_ticks": 200,
 "cleanup": [
  "kill @e[type=horse,distance=..48]",
  "kill @e[type=donkey,distance=..48]",
  "kill @e[type=mule,distance=..48]",
  "kill @e[type=skeleton_horse,distance=..48]",
  "kill @e[type=zombie_horse,distance=..48]",
  "kill @e[type=item,distance=..48]",
  "kill @e[type=experience_orb,distance=..48]",
  "gamemode creative $(bot)",
  "clear $(bot)",
  "!startfly"
 ],
 "random": [
  {
   "type": "count",
   "name": "\u0433\u043e\u043b\u043e\u0441 \u0432 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0439 \u0442\u0430\u043a\u0442",
