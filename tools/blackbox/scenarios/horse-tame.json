{
 "name": "horse-tame",
 "about": "Untamed horse, NoAI so nothing is random: empty-hand mounting, dismount by sneaking, apple feeding (eat sound, mouth flag). Random run-around/taming is horse-tame-run.",
 "track_mobs": true,
 "track_self": true,
 "blocks": [],
 "setup": [
  "difficulty normal",
  "gamemode survival $(bot)",
  "clear $(bot)",
  "tp $(bot) $(3.5,0,0.5) 0 0",
  "!stopfly",
  "!wait 10",
  "give $(bot) minecraft:apple 3",
  "!hotbar 0"
 ],
