    }
  ],
  "record_ticks": 90,
  "cleanup": [
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "difficulty peaceful",
    "gamerule natural_health_regeneration true",
    "effect clear $(bot)",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "!wait 4",
    "!startfly",
    "kill @e[type=item,distance=..48]",
    "kill @e[tag=itemaudit2,distance=..48]",
    "effect clear $(bot)",
    "kill @e[type=arrow,distance=..48]",
    "kill @e[type=spectral_arrow,distance=..48]",
    "kill @e[type=snowball,distance=..48]"
  ],
  "track_self": true,
  "item_components": true,
  "inventory": true,
  "exclusive": true,
  "track_mobs": true,
  "random": [
    {
      "type": "mask",
      "name": "направление отдачи без источника",
      "kind": "self",
      "pattern": "^(self робот: скорость) -?[0-9.]+,(0\\.361),-?[0-9.]+$",
      "replace": "$1 X,$2,Z",
      "why": "урон командой без нападающего: отдача 0,4 в случайную сторону; у оригинала пять записей дали пять направлений (0.389,0.093; 0.335,0.218; -0.346,-0.201; -0.378,-0.13; 0.396,-0.059), длина всегда 0,4"
    },
    {
      "type": "count",
      "name": "мычание коровы",
      "match": "entity\\.cow\\.ambient",
      "range": [
        0,
        2
      ],
      "anytick": true,
      "why": "вики, Cow: звук «ambient» в случайный момент"
    }
  ]
