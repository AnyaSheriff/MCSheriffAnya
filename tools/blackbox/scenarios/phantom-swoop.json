{
 "name": "phantom-swoop",
 "about": "Фантом с ИИ (size 0) в 28 блоках над роботом (выживание, нормально, полночь, площадка на высоте 70). Кружит над игроком, пикирует, бьёт (урон по сложности), отлетает наверх. Размер, метаданные, звуки, урон и повторные пике — сверка с оригиналом.",
 "track_mobs": true,
 "track_self": true,
 "exclusive": true,
 "pad_up": 60,
 "pad_wide": 40,
 "timeout_ms": 300000,
 "origin": [100, 70, 100],
 "blocks": [],
 "setup": [
  "difficulty normal",
  "time set midnight",
  "gamemode survival $(bot)",
  "clear $(bot)",
  "tp $(bot) $(0.5,0,0.5)",
  "!wait 20",
  "tp $(bot) $(0.5,0,0.5)",
  "!stopfly",
  "!wait 10"
 ],
 "actions": [
  { "after": 0, "cmd": "summon phantom $(0.5,28,0.5) {Silent:0b,size:0}" }
 ],
 "record_ticks": 900,
 "cleanup": [
  "kill @e[type=phantom,distance=..128]",
  "kill @e[type=item,distance=..128]",
  "difficulty peaceful",
  "gamemode creative $(bot)",
  "clear $(bot)",
  "!wait 4",
  "!startfly",
  "time set noon"
 ]
}
