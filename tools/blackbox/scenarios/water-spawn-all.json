{
  "name": "water-spawn-all",
  "about": "Every water mob summoned NoAI: spawn packets, metadata and attributes.",
  "track_mobs": true,
  "track_self": true,
  "exclusive": true,
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "tp $(bot) $(3.5,1,6.5)",
    "!wait 5",
    "fill $(0,-1,0) $(7,2,7) minecraft:stone",
    "fill $(1,0,1) $(6,2,6) minecraft:air",
    "fill $(1,0,1) $(6,1,6) minecraft:water",
    "gamemode survival $(bot)",
    "effect give $(bot) minecraft:water_breathing 30 0 true",
    "tp $(bot) $(3.5,0,6.5)",
    "!stopfly"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "summon cod $(1.5,0,1.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 2,
      "cmd": "summon salmon $(3.5,0,1.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 4,
      "cmd": "summon tropical_fish $(5.5,0,1.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 6,
      "cmd": "summon pufferfish $(1.5,0,3.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 8,
      "cmd": "summon squid $(3.5,0,3.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 10,
      "cmd": "summon glow_squid $(5.5,0,3.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 12,
      "cmd": "summon dolphin $(1.5,0,5.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 14,
      "cmd": "summon turtle $(3.5,0,5.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 16,
      "cmd": "summon axolotl $(5.5,0,5.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 18,
      "cmd": "summon frog $(1.5,1,1.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 20,
      "cmd": "summon tadpole $(3.5,1,1.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 22,
      "cmd": "summon turtle $(5.5,1,1.5) {NoAI:1b,Silent:1b,Age:-24000}"
    },
    {
      "after": 24,
      "cmd": "summon dolphin $(1.5,1,3.5) {NoAI:1b,Silent:1b,Age:-24000}"
    },
    {
      "after": 26,
      "cmd": "summon axolotl $(3.5,1,3.5) {NoAI:1b,Silent:1b,Variant:3,Age:-24000}"
    },
    {
      "after": 28,
      "cmd": "summon frog $(5.5,1,3.5) {NoAI:1b,Silent:1b,variant:\"minecraft:cold\"}"
    },
    {
      "after": 30,
      "cmd": "summon salmon $(1.5,1,5.5) {NoAI:1b,Silent:1b,type:\"large\"}"
    }
  ],
  "record_ticks": 60,
  "cleanup": [
    "gamemode creative $(bot)",
    "tp $(bot) $(3.5,3,6.5)",
    "!startfly",
    "kill @e[type=cod,distance=..48]",
    "kill @e[type=salmon,distance=..48]",
    "kill @e[type=tropical_fish,distance=..48]",
    "kill @e[type=pufferfish,distance=..48]",
    "kill @e[type=squid,distance=..48]",
    "kill @e[type=glow_squid,distance=..48]",
    "kill @e[type=dolphin,distance=..48]",
    "kill @e[type=turtle,distance=..48]",
    "kill @e[type=axolotl,distance=..48]",
    "kill @e[type=frog,distance=..48]",
    "kill @e[type=tadpole,distance=..48]",
    "kill @e[type=slime,distance=..48]",
    "kill @e[type=magma_cube,distance=..48]",
    "kill @e[type=item,distance=..48]",
    "kill @e[type=experience_orb,distance=..48]",
    "fill $(0,-1,0) $(7,2,7) minecraft:air",
    "fill $(0,-1,0) $(7,-1,7) minecraft:stone",
    "clear $(bot)",
    "effect clear $(bot)",
    "difficulty peaceful",
    "time set noon"
  ],
  "random": [
    {
      "type": "count",
      "name": "оборот щупалец",
      "match": "событие 19",
      "range": [
        0,
        6
      ],
      "anytick": true,
      "why": "событие 19 уходит на каждом обороте щупалец; скорость вращения у каждого кальмара своя и случайная (период 31–63 такта)"
    },
    {
      "type": "mask",
      "name": "порядок атрибутов дельфина",
      "kind": "cart",
      "pattern": "^(cart dolphin entity_update_attributes ).*$",
      "replace": "$1ATTRS",
      "why": "список атрибутов дельфина (скорость и кислородный бонус) у оригинала уходит в разном порядке от запуска к запуску"
    }
  ]
}