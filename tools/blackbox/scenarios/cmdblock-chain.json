{
  "name": "cmdblock-chain",
  "about": "Цепочка: импульсный блок и четыре цепных (always active) в ряд на восток; третий не удаётся, четвёртый условный и не срабатывает, пятый срабатывает. Всё в одном такте, по порядку.",
  "chat": true,
  "track_self": true,
  "blocks": [
    { "at": [-1, 0, 0], "state": "minecraft:lever[face=floor,facing=north,powered=false]" }
  ],
  "setup": [
    "setblock $(0,0,0) minecraft:command_block[facing=east]{Command:\"setblock ~ ~ ~2 minecraft:stone\"}",
    "setblock $(1,0,0) minecraft:chain_command_block[facing=east]{auto:1b,Command:\"setblock ~ ~ ~2 minecraft:oak_planks\"}",
    "setblock $(2,0,0) minecraft:chain_command_block[facing=east]{auto:1b,Command:\"setblock ~-2 ~ ~2 minecraft:stone\"}",
    "setblock $(3,0,0) minecraft:chain_command_block[facing=east,conditional=true]{auto:1b,Command:\"setblock ~ ~ ~2 minecraft:glass\"}",
    "setblock $(4,0,0) minecraft:chain_command_block[facing=east]{auto:1b,Command:\"setblock ~ ~ ~2 minecraft:dirt\"}"
  ],
  "actions": [
    { "after": 0, "click": [-1, 0, 0] },
    { "after": 10, "click": [-1, 0, 0] },
    { "after": 15, "cmd": "setblock $(2,0,2) minecraft:air" },
    { "after": 20, "click": [-1, 0, 0] }
  ],
  "cleanup": ["fill $(-1,0,0) $(4,0,2) minecraft:air"],
  "record_ticks": 35
}
