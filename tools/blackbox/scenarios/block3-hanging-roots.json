{
  "name": "block3-hanging-roots",
  "about": "Костная мука на корнистой земле создаёт корни снизу; повтор при занятости не действует; корни теряют опору [проверить] Java 26.1.2; подготовлено без запуска.",
  "track_self": true,
  "track_items": true,
  "blocks": [
    {
      "at": [
        0,
        3,
        0
      ],
      "state": "minecraft:rooted_dirt"
    }
  ],
  "setup": [
    "clear $(bot)",
    "gamemode survival $(bot)",
    "tp $(bot) $(0.5,0,2.5)",
    "!stopfly",
    "give $(bot) bone_meal 8",
    "!hotbar 0"
  ],
  "actions": [
    {
      "after": 0,
      "click": [
        0,
        3,
        0
      ],
      "face": 1
    },
    {
      "after": 10,
      "click": [
        0,
        3,
        0
      ],
      "face": 1
    },
    {
      "after": 20,
      "cmd": "setblock $(0,3,0) air"
    }
  ],
  "record_ticks": 70,
  "cleanup": [
    "clear $(bot)",
    "fill $(-2,0,-2) $(4,7,1) air",
    "kill @e[type=item,distance=..12]",
    "gamemode creative $(bot)"
  ]
}
