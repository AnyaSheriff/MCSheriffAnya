{
  "name": "cmdblock-impulse",
  "about": "Импульсный командный блок: ставится командой с NBT, рычаг — фронт сигнала, команда через такт; сравнитель читает SuccessCount (второй запуск не удаётся — 0); щелчок открывает окно, пакет Program Command Block меняет команду.",
  "chat": true,
  "track_self": true,
  "blocks": [
    { "at": [-1, 0, 0], "state": "minecraft:lever[face=floor,facing=north,powered=false]" },
    { "at": [1, 0, 0], "state": "minecraft:comparator[facing=west,mode=compare,powered=false]" },
    { "at": [2, 0, 0], "state": "minecraft:redstone_wire[east=side,north=none,power=0,south=none,west=side]" },
    { "at": [3, 0, 0], "state": "minecraft:redstone_lamp[lit=false]" }
  ],
  "actions": [
    { "after": 0, "cmd": "setblock $(0,0,0) minecraft:command_block[facing=up]{Command:\"setblock ~ ~1 ~ minecraft:stone\"}" },
    { "after": 5, "click": [-1, 0, 0] },
    { "after": 15, "click": [-1, 0, 0] },
    { "after": 25, "click": [-1, 0, 0] },
    { "after": 35, "click": [0, 0, 0] },
    { "after": 40, "program": { "at": [0, 0, 0], "command": "setblock ~ ~1 ~ minecraft:air", "mode": 2, "flags": 1 } },
    { "after": 45, "click": [-1, 0, 0] },
    { "after": 50, "click": [-1, 0, 0] }
  ],
  "cleanup": ["fill $(-1,0,0) $(3,1,0) minecraft:air"],
  "record_ticks": 70
}
