{
 "name": "bundle-use-drop",
 "about": "Held bundle with stone and dirt: right click held for 40 ticks (groups thrown out while using), release.",
 "blocks": [],
 "setup": [
  "clear $(bot)",
  "tp $(bot) $(0.5,0,2.5) 180 0",
  "gamemode survival $(bot)",
  "!stopfly",
  "give $(bot) minecraft:bundle[bundle_contents=[{id:\"minecraft:stone\",count:10},{id:\"minecraft:dirt\",count:5},{id:\"minecraft:sand\",count:3},{id:\"minecraft:gravel\",count:2}]]"
 ],
 "actions": [
  { "after": 0, "use": true },
  { "after": 70, "release": true }
 ],
 "cleanup": [
  "fill $(-5,0,-5) $(5,5,5) minecraft:air",
  "kill @e[type=item,distance=..48]",
  "clear $(bot)",
  "gamemode creative $(bot)"
 ],
 "record_ticks": 100,
 "origin": [0, -59, 0],
 "item_components": true,
 "track_self": true,
 "track_mobs": true
}
