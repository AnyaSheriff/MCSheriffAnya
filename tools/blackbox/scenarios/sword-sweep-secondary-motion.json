{
  "name": "sword-sweep-secondary-motion",
  "attr_phase": true,
  "about": "[проверить] Explicit primary target (which=0), off-axis secondary cow, third cow outside sweep range; repeated hit during immunity. pvp-sweep records radial damage knockback followed by facing knockback.",
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "effect clear $(bot)",
    "fill $(-4,-1,-4) $(7,-1,7) stone",
    "fill $(-4,0,-4) $(7,6,7) air",
    "tp $(bot) $(3.5,0,3.5) 180 0",
    "!hotbar 0",
    "give $(bot) wooden_sword[enchantments={\"minecraft:knockback\":3,\"minecraft:sweeping_edge\":3}]",
    "gamemode survival $(bot)"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "summon cow $(3.5,0,1.5) {NoAI:1b,Tags:[\"sweep_probe\"]}"
    },
    {
      "after": 0,
      "cmd": "summon cow $(4.4,0,1.5) {NoAI:1b,Tags:[\"sweep_probe\"]}"
    },
    {
      "after": 0,
      "cmd": "summon cow $(6.5,0,1.5) {NoAI:1b,Tags:[\"sweep_probe\"]}"
    },
    {
      "after": 20,
      "attack": true,
      "which": 0
    },
    {
      "after": 21,
      "attack": true,
      "which": 0
    }
  ],
  "record_ticks": 80,
  "cleanup": [
    "gamemode creative $(bot)",
    "clear $(bot)",
    "effect clear $(bot)",
    "kill @e[tag=sweep_probe]",
    "kill @e[type=item,distance=..32]",
    "kill @e[type=experience_orb,distance=..32]",
    "fill $(-4,-1,-4) $(7,6,7) air",
    "difficulty peaceful"
  ],
  "track_self": true,
  "track_mobs": true,
  "inventory": true,
  "item_components": true,
  "exclusive": true,
  "random": [
    {
      "type": "count",
      "name": "голос коровы в покое",
      "match": "entity\\.cow\\.ambient",
      "range": [
        0,
        6
      ],
      "anytick": true,
      "why": "Вики, Cow: ambient sounds; случайные голоса не связаны с отдачей (vanilla sword-sweep-neighbours)."
    }
  ]
}
