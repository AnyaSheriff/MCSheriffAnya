{
  "name": "bat-rest",
  "about": "Hanging bat loses its ceiling and takes off; resting flag and flight. [unverified]",
  "track_mobs": true,
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamemode survival $(bot)",
    "clear $(bot)",
    "tp $(bot) $(0.5,0,0.5)",
    "!stopfly",
    "!wait 10",
    "!look 0 0",
    "setblock $(3,3,3) stone"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "summon bat $(3.5,2.1,3.5) {BatFlags:1b,Silent:1b}"
    },
    {
      "after": 50,
      "cmd": "setblock $(3,3,3) air"
    }
  ],
  "record_ticks": 160,
  "cleanup": [
    "kill @e[type=bat,distance=..48]",
    "kill @e[type=item,distance=..48]",
    "kill @e[type=experience_orb,distance=..48]",
    "setblock $(3,3,3) air",
    "difficulty peaceful",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "!wait 4",
    "!startfly"
  ],
  "random": [
    {
      "type": "count",
      "name": "полёт мыши",
      "match": "bat (сдвиг|скорость|сверка|поворот|entity_head_rotation)",
      "range": [
        0,
        400
      ],
      "anytick": true,
      "why": "Цель полёта летучей мыши случайна: два прогона оригинала (vanilla-vs-vanilla) расходятся по каждому сдвигу и повороту; сверяются метаданные, атрибут и пробуждение."
    }
  ]
}