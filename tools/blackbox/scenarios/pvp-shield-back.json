  "kill @e[type=arrow,distance=..48]",
  "difficulty peaceful",
  "gamerule natural_health_regeneration true",
  "gamemode creative $(bot)",
  "gamemode creative $(bot2)",
  "clear $(bot)",
  "clear $(bot2)",
  "tp $(bot2) $(6.5,0,6.5)",
