{
  "name": "bedrock-entities-passengers",
  "about": "Shared passenger fixture: boat mount/dismount and happy-ghast four-seat links; commands establish shared state for a later Bedrock client capture.",
  "track_mobs": true,
  "exclusive": true,
  "origin": [
    120,
    64,
    120
  ],
  "blocks": [],
  "setup": [
    "gamemode creative $(bot)",
    "clear $(bot)",
    "fill $(-8,-1,-8) $(8,-1,12) minecraft:stone",
    "fill $(-8,0,-8) $(8,12,12) minecraft:air",
    "tp $(bot) $(0.5,1,0.5)",
    "!look 0 0"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "summon bamboo_raft $(0.5,0,4.5) {NoGravity:1b}"
    },
    {
      "after": 5,
      "cmd": "ride $(bot) mount @e[type=bamboo_raft,sort=nearest,limit=1]"
    },
    {
      "after": 15,
      "cmd": "ride $(bot) dismount"
    },
    {
      "after": 20,
      "cmd": "summon happy_ghast $(0.5,2,6.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 25,
      "cmd": "summon cow $(-2.5,0,6.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 25,
      "cmd": "summon pig $(-1.5,0,6.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 25,
      "cmd": "summon sheep $(2.5,0,6.5) {NoAI:1b,Silent:1b}"
    },
    {
      "after": 30,
      "cmd": "ride $(bot) mount @e[type=happy_ghast,sort=nearest,limit=1]"
    },
    {
      "after": 35,
      "cmd": "ride @e[type=cow,sort=nearest,limit=1] mount @e[type=happy_ghast,sort=nearest,limit=1]"
    },
    {
      "after": 40,
      "cmd": "ride @e[type=pig,sort=nearest,limit=1] mount @e[type=happy_ghast,sort=nearest,limit=1]"
    },
    {
      "after": 45,
      "cmd": "ride @e[type=sheep,sort=nearest,limit=1] mount @e[type=happy_ghast,sort=nearest,limit=1]"
    },
    {
      "after": 55,
      "cmd": "ride $(bot) dismount"
    },
    {
      "after": 60,
      "cmd": "ride @e[type=cow,sort=nearest,limit=1] dismount"
    }
  ],
  "cleanup": [
    "kill @e[type=!player,distance=..40]",
    "fill $(-8,-1,-8) $(8,12,12) minecraft:air",
    "clear $(bot)",
    "gamemode creative $(bot)",
    "!startfly"
  ],
  "record_ticks": 90
}
