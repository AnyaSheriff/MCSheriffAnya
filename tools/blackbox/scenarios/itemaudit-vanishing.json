{
  "name": "itemaudit-vanishing",
  "about": "[проверить] При смерти без keep_inventory проклятый меч исчезает, обычный stone выпадает. Сценарий создан до реализации; не запускался.",
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamerule natural_health_regeneration false",
    "gamemode survival $(bot)",
    "clear $(bot)",
    "kill $(bot)",
    "!wait 20",
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "tp $(bot) $(3.5,0,3.5)",
    "!stopfly",
    "!look 0 0",
    "give $(bot) minecraft:diamond_sword[enchantments={\"minecraft:vanishing_curse\":1}] 1",
    "!hotbar 0",
    "!wait 10",
    "!wait 25",
    "gamerule keep_inventory false",
    "give $(bot) minecraft:stone 1"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "kill $(bot)"
    }
  ],
  "record_ticks": 60,
  "cleanup": [
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "difficulty peaceful",
    "gamerule natural_health_regeneration true",
    "effect clear $(bot)",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "!wait 4",
    "!startfly",
    "kill @e[type=item,distance=..48]"
  ],
  "track_self": true,
  "item_components": true,
  "inventory": true,
  "track_mobs": true,
  "exclusive": true
}
