{
  "name": "itemaudit-binding",
  "about": "[проверить] Binding: нельзя снять helmet кликом, shift, hotbar swap или Q в survival; creative снимает. Не запускался.",
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamerule natural_health_regeneration false",
    "gamemode survival $(bot)",
    "clear $(bot)",
    "kill $(bot)",
    "!wait 20",
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "tp $(bot) $(3.5,0,3.5)",
    "!stopfly",
    "!look 0 0",
    "!hotbar 0",
    "!wait 10",
    "!wait 25",
    "item replace entity $(bot) armor.head with diamond_helmet[enchantments={binding_curse:1}]"
  ],
  "actions": [
    {
      "after": 0,
      "window_click": {
        "slot": 5,
        "mode": 0
      }
    },
    {
      "after": 5,
      "window_click": {
        "slot": 5,
        "mode": 1
      }
    },
    {
      "after": 10,
      "window_click": {
        "slot": 5,
        "mode": 2,
        "button": 0
      }
    },
    {
      "after": 15,
      "window_click": {
        "slot": 5,
        "mode": 4,
        "button": 1
      }
    },
    {
      "after": 20,
      "cmd": "gamemode creative $(bot)"
    },
    {
      "after": 25,
      "window_click": {
        "slot": 5,
        "mode": 0
      }
    }
  ],
  "record_ticks": 40,
  "cleanup": [
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "difficulty peaceful",
    "gamerule natural_health_regeneration true",
    "effect clear $(bot)",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "!wait 4",
    "!startfly",
    "kill @e[type=item,distance=..48]"
  ],
  "track_self": true,
  "item_components": true,
  "inventory": true,
  "exclusive": true
}
