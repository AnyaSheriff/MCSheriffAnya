{
  "name": "block3-short-grass",
  "about": "Костная мука выращивает согласованную пару; разрушение одной половины убирает вторую [проверить] Java 26.1.2; подготовлено без запуска.",
  "track_self": true,
  "track_items": true,
  "blocks": [
    {
      "at": [
        0,
        0,
        0
      ],
      "state": "minecraft:dirt"
    },
    {
      "at": [
        0,
        1,
        0
      ],
      "state": "minecraft:short_grass"
    },
    {
      "at": [
        0,
        2,
        0
      ],
      "state": "minecraft:air"
    }
  ],
  "setup": [
    "clear $(bot)",
    "gamemode survival $(bot)",
    "tp $(bot) $(0.5,0,2.5)",
    "!stopfly",
    "give $(bot) bone_meal 8",
    "!hotbar 0"
  ],
  "actions": [
    {
      "after": 0,
      "click": [
        0,
        1,
        0
      ],
      "face": 1
    },
    {
      "after": 10,
      "cmd": "setblock $(0,2,0) air"
    }
  ],
  "record_ticks": 70,
  "cleanup": [
    "clear $(bot)",
    "fill $(-2,0,-2) $(4,7,1) air",
    "kill @e[type=item,distance=..12]",
    "gamemode creative $(bot)"
  ]
}
