{
 "name": "drowned-attack",
 "about": "Утопленник с ИИ в пруду 5×5×3 у берега, робот в выживании на берегу: плывёт к нему, выходит/бьёт у кромки воды; урон, звуки воды и суши [проверить по записи].",
 "track_mobs": true,
 "track_self": true,
 "exclusive": true,
 "blocks": [],
 "setup": [
  "difficulty normal",
  "time set midnight",
  "tp $(bot) $(4.5,2,6.5)",
  "!wait 5",
  "fill $(0,-3,0) $(8,-2,8) minecraft:stone",
  "fill $(0,-1,0) $(8,-1,8) minecraft:stone",
  "fill $(2,-2,0) $(6,-1,4) minecraft:air",
  "fill $(2,-2,0) $(6,-1,4) minecraft:water",
  "gamemode survival $(bot)",
  "clear $(bot)",
  "kill $(bot)",
  "!wait 20",
  "tp $(bot) $(4.5,0,6.5)",
  "!stopfly",
  "!wait 10"
 ],
 "actions": [
  {
   "after": 0,
   "cmd": "summon drowned $(4.5,-1,0.5) {Silent:1b,equipment:{mainhand:{id:\"minecraft:nautilus_shell\",count:1}}}"
  }
 ],
 "record_ticks": 200,
 "cleanup": [
  "kill @e[type=drowned,distance=..48]",
  "kill @e[type=item,distance=..48]",
  "difficulty peaceful",
  "gamemode creative $(bot)",
  "clear $(bot)",
  "!wait 4",
  "!startfly",
  "fill $(0,-1,0) $(8,0,8) minecraft:air",
  "fill $(0,-2,0) $(8,-2,8) minecraft:stone",
  "time set noon"
 ],
 "random": [
  {
   "type": "count",
   "name": "плавание",
   "match": "^cart drowned|^meta ",
   "range": [
    0,
    1000
   ],
   "anytick": true,
