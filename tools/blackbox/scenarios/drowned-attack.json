  },
  {
   "type": "count",
   "name": "удары и их последствия",
   "match": "^sv |^self ",
   "range": [
    0,
    300
   ],
   "anytick": true,
   "why": "старт погони случаен; удары раз в 20 тактов [проверить]"
  }
 ]
