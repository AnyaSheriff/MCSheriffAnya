    "gamemode creative $(bot)",
    "clear $(bot)",
    "effect clear $(bot)",
    "fill $(-4,-1,-4) $(6,-1,6) stone",
    "fill $(-4,0,-4) $(6,6,6) air",
    "tp $(bot) $(3.5,0,3.5)",
    "!hotbar 0",
