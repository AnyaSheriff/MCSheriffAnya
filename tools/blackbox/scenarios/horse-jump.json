 "random": [
  {
   "type": "count",
   "name": "\u0433\u043e\u043b\u043e\u0441 \u0432 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0439 \u0442\u0430\u043a\u0442",
   "match": "^sound [^ ]+ minecraft:entity\\.(horse|donkey|mule|skeleton_horse|zombie_horse)\\.ambient",
   "range": [
    0,
    3
   ],
   "anytick": true,
   "why": "ambient voice is rolled at random ticks (vanilla vs vanilla: mount tick +15 in one run, +40 in another)"
  },
  {
   "type": "count",
   "name": "\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u043e\u0432",
   "match": "^cart horse entity_update_attributes",
   "range": [
    2,
    8
   ],
   "anytick": false,
   "why": "vanilla lists attributes in hash order that differs run to run: [jump,speed,health] in horse-saddle-ride but [speed,jump,health] in horse-jump (same NBT)"
  }
 ]
