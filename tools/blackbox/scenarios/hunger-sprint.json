  "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
  "tp $(bot) $(3.5,0,3.5)",
  "!stopfly",
  "!look 0 0",
  "effect give $(bot) minecraft:hunger 1 255 true",
  "!wait 30"
 ],
 "actions": [
  {
   "after": 0,
