    "forward",
    true
   ]
  },
  {
   "after": 0,
   "control": [
    "sprint",
    true
   ]
  },
  {
   "after": 160,
   "control": [
    "forward",
    false
   ]
  },
  {
   "after": 160,
   "control": [
    "sprint",
    false
   ]
  }
 ],
 "record_ticks": 200,
 "cleanup": [
  "difficulty peaceful",
  "gamemode creative $(bot)",
  "!wait 4",
  "!startfly"
 ],
