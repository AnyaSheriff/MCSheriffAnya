{
  "name": "itemaudit-food-rotten-flesh",
  "about": "[проверить] rotten_flesh: nutrition, saturation, consume и food effects после еды. RNG не замаскирован; нужны vanilla-vs-vanilla измерения. Не запускался.",
  "blocks": [],
  "setup": [
    "difficulty normal",
    "gamerule natural_health_regeneration false",
    "gamemode survival $(bot)",
