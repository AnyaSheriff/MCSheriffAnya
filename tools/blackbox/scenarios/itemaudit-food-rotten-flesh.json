    "kill $(bot)",
    "!wait 20",
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "tp $(bot) $(3.5,0,3.5)",
    "!stopfly",
    "!look 0 0",
    "give $(bot) minecraft:rotten_flesh 1",
    "!hotbar 0",
    "!wait 10",
    "!wait 25",
    "effect give $(bot) minecraft:hunger 3 255 true",
    "!wait 65"
  ],
  "actions": [
    {
      "after": 0,
      "use": true
    }
  ],
  "record_ticks": 100,
  "cleanup": [
    "fill $(2,0,-70) $(4,3,4) minecraft:air",
    "fill $(2,-1,-70) $(4,-1,4) minecraft:stone",
    "difficulty peaceful",
    "gamerule natural_health_regeneration true",
    "effect clear $(bot)",
    "gamemode creative $(bot)",
    "clear $(bot)",
    "!wait 4",
    "!startfly",
    "kill @e[type=item,distance=..48]"
