        0
      ],
      "state": "minecraft:glass"
    },
    {
      "at": [
        1,
        1,
        -1
      ],
      "state": "minecraft:glass"
    },
    {
      "at": [
        1,
        1,
        1
      ],
      "state": "minecraft:glass"
    },
    {
      "at": [
        1,
        2,
        0
      ],
      "state": "minecraft:glass"
    }
  ],
  "setup": [
    "gamerule random_tick_speed 0"
  ],
  "actions": [
    {
      "after": 0,
      "cmd": "setblock $(0,1,0) minecraft:tube_coral[waterlogged=false]"
