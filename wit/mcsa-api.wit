// API плагинов MCSheriffAnya, версия 0.1.
// Java SDK сохраняет публичное подмножество org.bukkit; ru.mcsa.bukkit —
// внутренний мост переводчика. ABI компонента задаётся только этим WIT.
// Идентификатор игрока — UUID строкой «8-4-4-4-12».
// Имена блоков и предметов — с приставкой minecraft: или без неё.

package mcsa:api@0.1.0;

interface types {
    /// Измерение.
    enum dimension { overworld, nether, end }

    /// Режим игры.
    enum game-mode { survival, creative, adventure, spectator }

    /// Игрок на сервере в момент вызова.
    record player {
        uuid: string,
        name: string,
        game-mode: game-mode,
        dimension: dimension,
        x: f64,
        y: f64,
        z: f64,
        yaw: f32,
        pitch: f32,
    }

    /// Место в мире (дробные координаты, куда смотрит).
    record location {
        dimension: dimension,
        x: f64,
        y: f64,
        z: f64,
        yaw: option<f32>,
        pitch: option<f32>,
    }

    /// Блок в мире по целым координатам.
    record block-pos {
        dimension: dimension,
        x: s32,
        y: s32,
        z: s32,
    }

    /// Стопка предметов.
    record item-stack {
        /// `diamond_sword`, `minecraft:bread` …
        item: string,
        count: u32,
    }

    /// Ответ обработчику отменяемого события.
    enum verdict {
        /// Пропустить.
        allow,
        /// Отменить: блок не ломается, не ставится, команда не выполняется.
        deny,
    }

    /// Ответ обработчику чата.
    variant chat-result {
        /// Пропустить как есть.
        pass,
        /// Не рассылать сообщение.
        cancel,
        /// Разослать вместо него этот текст (текст сообщения, без «<имя>»).
        replace(string),
    }

    /// Кто вызвал команду.
    enum sender-kind { player, console, command-block }

    record sender {
        kind: sender-kind,
        /// UUID, если вызвал игрок.
        uuid: option<string>,
        name: string,
    }

    /// Итог команды плагина.
    record command-result {
        success: bool,
        /// Ответ вызвавшему (может быть пустым).
        message: option<string>,
    }
}

interface log {
    enum level { debug, info, warn, error }

    /// Строка в консоль сервера с именем плагина.
    write: func(level: level, message: string);
}

interface server {
    use types.{player};

    /// Версия API, с которой работает сервер (`0.1`).
    api-version: func() -> string;

    /// Номер текущего такта мира с запуска.
    current-tick: func() -> u64;
    is-stopping: func() -> bool;

    /// Сообщение всем в чат (и в консоль).
    broadcast: func(message: string);

    /// Кто сейчас на сервере.
    online-players: func() -> list<player>;
    /// Игроки Java с опубликованным снимком, доступные Bukkit во время входа.
    ready-players: func() -> list<player>;

    /// Игрок по нику (без учёта регистра).
    find-player: func(name: string) -> option<player>;
}

interface player {
    set-silent: func(uuid: string, silent: bool) -> result<_, string>;
    get-silent: func(uuid: string) -> result<bool, string>;
    vehicle: func(uuid: string) -> result<option<string>, string>;
    inside-vehicle: func(uuid: string) -> result<bool, string>;
    record flight { allowed: bool, flying: bool, fall-damage: s8 }
    get-flight: func(uuid: string) -> result<flight, string>;
    /// Поле: 0 — разрешение, 1 — полёт, 2 — урон (-1: обычные правила).
    set-flight: func(uuid: string, field: u8, value: s8) -> result<_, string>;

    use types.{location, item-stack, game-mode, block-pos};
    record bed-action { bed: block-pos, problem: u32, can-spawn: bool, can-sleep: bool }
    /// Снимок правил кровати, без изменения мира и без удержания его замка в обработчике.
    get-bed-action: func(uuid: string, pos: block-pos) -> option<bed-action>;
    set-respawn: func(uuid: string, to: option<location>) -> result<_, string>;

    /// Личное сообщение. false — игрока нет на сервере.
    send-message: func(uuid: string, message: string) -> bool;

    /// Перенести игрока (в том числе в другое измерение).
    teleport: func(uuid: string, to: location) -> bool;

    /// Выдать предметы: что не влезло — падает на землю.
    give-item: func(uuid: string, stack: item-stack) -> result<_, string>;

    /// Сменить режим игры без исполнения команды.
    set-game-mode: func(uuid: string, mode: game-mode) -> bool;

    /// Уровень оператора; none — игрок отсутствует. Права не повышает.
    operator-level: func(uuid: string) -> option<u8>;

    /// Заменить ячейку окна игрока (9..44); none очищает ячейку.
    set-inventory-slot: func(uuid: string, slot: u32, stack: option<item-stack>) -> result<_, string>;

    /// Здоровье 0..max-health; ноль вызывает обычную смерть, без возрождения.
    set-health: func(uuid: string, health: f64) -> result<_, string>;
    record potion-effect {
        kind: string,
        /// Число тактов; -1 означает бессрочный эффект.
        duration: s32,
        amplifier: s32,
        ambient: bool,
        particles: bool,
        icon: bool,
    }
    add-potion-effect: func(uuid: string, effect: potion-effect) -> result<_, string>;
    remove-potion-effect: func(uuid: string, kind: string) -> result<_, string>;
    record state {
        fire-ticks: s32,
        dead: bool,
        sneaking: bool,
        on-ground: bool,
        in-water: bool,
        in-lava: bool,
        in-rain: bool,
        eye-height: f64,
        effects: list<potion-effect>,
        using-item: bool,
        off-hand: bool,
    }
    get-state: func(uuid: string) -> result<state, string>;
    set-fire-ticks: func(uuid: string, ticks: s32) -> result<_, string>;
    damage: func(uuid: string, amount: f64) -> result<_, string>;
    give-experience: func(uuid: string, amount: s32) -> result<_, string>;

    /// Выгнать с сервера.
    kick: func(uuid: string, reason: string) -> bool;
}

/// Компоненты текста — JSON; сервер проверяет их и кодирует в anonymous NBT.
/// UI только Java. false означает: игрок отсутствует, Bedrock или неверные данные.
/// Ресурсы принадлежат плагину, очищаются при выгрузке; id локален плагину.
interface presentation {
    record player-info {
        ping: u32,
        health: f32,
        max-health: f32,
        %world: string,
        display-name: string,
        food: s32,
        level: s32,
        exp: f32,
        operator-level: u8,
    }
    record server-info {
        tps: f32,
        mspt: f32,
        online: u32,
        max-players: u32,
    }
    record team {
        id: string,
        prefix: string,
        suffix: string,
        color: string,
        visibility: string,
        members: list<string>,
    }
    record objective {
        id: string,
        title: string,
        hearts: bool,
    }
    record score {
        objective: string,
        holder: string,
        value: s32,
        display: option<string>,
        /// none — обычное число, some — fixed-компонент вместо числа.
        number: option<string>,
    }
    record boss-bar {
        id: string,
        title: string,
        progress: f32,
        color: string,
        style: string,
    }
    get-player-info: func(uuid: string) -> option<player-info>;
    get-server-info: func() -> server-info;
    set-tab-header-footer: func(uuid: string, header: string, footer: string) -> bool;
    /// Возвращает заголовок/подвал ядру, только если им владеет вызывающий.
    reset-tab-header-footer: func(uuid: string) -> bool;
    set-display-name: func(uuid: string, text: string) -> bool;
    set-player-list-name: func(uuid: string, text: string) -> bool;
    set-team: func(uuid: string, value: team) -> bool;
    remove-team: func(uuid: string, id: string) -> bool;
    set-objective: func(uuid: string, value: objective) -> bool;
    remove-objective: func(uuid: string, id: string) -> bool;
    /// list, sidebar, below_name; none снимает только собственный слот.
    set-display-slot: func(uuid: string, slot: string, objective: option<string>) -> bool;
    set-score: func(uuid: string, value: score) -> bool;
    remove-score: func(uuid: string, objective: string, holder: string) -> bool;
    set-boss-bar: func(uuid: string, value: boss-bar) -> bool;
    remove-boss-bar: func(uuid: string, id: string) -> bool;
    set-action-bar: func(uuid: string, text: string) -> bool;
    send-component: func(uuid: string, text: string) -> bool;
    broadcast-component: func(text: string) -> bool;
    /// Удаляет оформление вызывающего плагина для этого игрока.
    reset-player: func(uuid: string) -> bool;
}

interface %world {
    monster-limit: func(dimension: dimension) -> u32;
    set-monster-limit: func(dimension: dimension, limit: s32) -> result<_, string>;
    record ray-hit { x: f64, y: f64, z: f64, block: block-pos, face: u8 }
    ray-blocks: func(start: location, dx: f64, dy: f64, dz: f64, distance: f64, fluids: u8, ignore-passable: bool) -> result<option<ray-hit>, string>;

    use types.{block-pos, location, dimension};
    record block-state { data: string, sky: u8, light: u8, liquid: bool, passable: bool, age: s32, max-age: s32 }
    block-cube: func(start: block-pos) -> result<list<string>, string>;
    block-details: func(pos: block-pos) -> result<block-state, string>;
    update-block: func(pos: block-pos, data: string, force: bool, physics: bool) -> result<bool, string>;
    random-tick: func(pos: block-pos) -> result<_, string>;
    chunk-loaded: func(dimension: dimension, x: s32, z: s32) -> bool;
    highest-block: func(dimension: dimension, x: s32, z: s32) -> result<s32, string>;
    random-tick-speed: func() -> u32;
    spawn-particle: func(at: location, name: string, count: u32, dx: f64, dy: f64, dz: f64) -> result<_, string>;
    break-naturally: func(pos: block-pos) -> result<bool, string>;
    play-sound: func(at: location, sound: string, volume: f32, pitch: f32) -> result<_, string>;

    record border { size: f64, center-x: f64, center-z: f64 }
    get-border: func(dimension: dimension) -> border;
    /// Мгновенное изменение рамки; предупреждения и урон сохраняются.
    set-border: func(dimension: dimension, value: border) -> result<_, string>;

    /// Имя блока (`minecraft:stone`). none — чанк не загружен.
    get-block: func(pos: block-pos) -> option<string>;

    /// Поставить блок: `stone`, `minecraft:lever[face=floor]`.
    set-block: func(pos: block-pos, block: string) -> result<_, string>;

    /// Время суток, 0..23999.
    time: func(dimension: dimension) -> u32;
    set-time: func(dimension: dimension, ticks: u32);

    /// Погода: clear, rain, thunder; срок 1..2400000 тактов.
    weather: func(dimension: dimension) -> string;
    set-weather: func(dimension: dimension, kind: string, duration: u32) -> result<_, string>;

    /// Общая точка появления измерения.
    spawn-location: func(dimension: dimension) -> location;
}

interface scheduler {
    /// Выполнить задачу `task` (её номер плагин выбирает сам) через `delay`
    /// тактов — на такте мира. Возвращает номер для отмены.
    run-later: func(delay: u32, task: u32) -> u32;

    /// То же, но повторять каждые `period` тактов (не меньше 1).
    run-repeating: func(delay: u32, period: u32, task: u32) -> u32;

    /// Отменить задачу по номеру. false — такой уже нет.
    cancel: func(handle: u32) -> bool;
}

interface entities {
    use types.{dimension};
    use player.{potion-effect};
    record snapshot { uuid: string, kind: string, at: location, width: f64, height: f64, health: f64, living: bool, hostile: bool, animal: bool, shooter: string, embedded: bool }
    describe: func(uuid: string) -> result<snapshot, string>;
    in-world: func(dimension: dimension) -> result<list<snapshot>, string>;
    cloud-potion: func(uuid: string) -> result<option<string>, string>;
    effects: func(uuid: string) -> result<list<potion-effect>, string>;
    equipment: func(uuid: string, slot: u8) -> result<option<item>, string>;
    set-health: func(uuid: string, health: f64) -> result<_, string>;
    teleport: func(uuid: string, at: location) -> result<bool, string>;
    launch: func(uuid: string, kind: string, velocity: vector) -> result<string, string>;
    set-explosive: func(uuid: string, yield: option<f32>, incendiary: option<bool>) -> result<_, string>;
    record horse-state { tamed: bool, chest: bool, items: list<option<item>> }
    horse: func(uuid: string) -> result<horse-state, string>;
    set-horse-item: func(uuid: string, slot: u32, stack: option<item>) -> result<_, string>;
    tame-horse: func(uuid: string, tamed: bool) -> result<_, string>;
    set-horse-owner: func(uuid: string, owner: option<string>) -> result<_, string>;
    create-mob: func(at: location, kind: string) -> result<string, string>;
    finish-mob: func(uuid: string, commit: bool) -> result<_, string>;
    mob-control: func(uuid: string, field: u8, value: s32) -> result<_, string>;
    get-target: func(uuid: string) -> result<option<string>, string>;
    set-target: func(uuid: string, target: option<string>) -> result<_, string>;
    set-arrow-critical: func(uuid: string, critical: bool) -> result<_, string>;
    set-potion-item: func(uuid: string, stack: item) -> result<_, string>;

    use types.{location};
    use inventory.{item};
    record vector { x: f64, y: f64, z: f64 }
    velocity: func(uuid: string) -> result<vector, string>;
    set-velocity: func(uuid: string, value: vector) -> result<_, string>;
    remove: func(uuid: string) -> result<_, string>;
    drop-item: func(at: location, stack: item, natural: bool) -> result<string, string>;
    item-stack: func(uuid: string) -> result<item, string>;
    set-item-stack: func(uuid: string, stack: item) -> result<_, string>;
    item-location: func(uuid: string) -> result<location, string>;
    item-teleport: func(uuid: string, at: location) -> result<bool, string>;
    valid: func(uuid: string) -> bool;
}

interface command {
    record command-spec {
        /// Имя без косой черты: `[a-z0-9_-]+`.
        name: string,
        description: string,
        usage: string,
        /// Нужный уровень прав оператора: 0 — всем, 4 — только владельцам.
        level: u8,
        /// Узел права (`hello.use`): зарезервирован под будущую систему прав,
        /// пока действует только `level`.
        permission: option<string>,
    }

    /// Зарегистрировать команду. Когда её вызовут — придёт `events.on-command`.
    register: func(spec: command-spec) -> result<_, string>;
}

interface storage {
    /// Текст `config.toml` плагина. Нет файла — создаётся из `default-text`.
    config: func(default-text: string) -> result<string, string>;

    /// Перезаписать `config.toml`.
    save-config: func(text: string) -> result<_, string>;

    /// Прочитать файл из папки данных плагина (`<плагин>/data/`).
    /// Путь относительный, без `..` и символических ссылок; размер до 4 МиБ.
    read: func(name: string) -> result<option<list<u8>>, string>;

    /// Записать файл в папку данных.
    write: func(name: string, data: list<u8>) -> result<_, string>;

    /// Копировать или атомарно переместить внутри папки данных.
    transfer: func(source: string, target: string, replace: bool, move-file: bool) -> result<_, string>;

    /// Удалить файл из папки данных. false — его не было.
    delete: func(name: string) -> result<bool, string>;
}

/// Атрибуты игроков: основа и именованные модификаторы.
interface attributes {
    record modifier { id: string, amount: f64, operation: u8 }
    record snapshot { base: f64, value: f64, modifiers: list<modifier> }
    get: func(uuid: string, name: string) -> result<snapshot, string>;
    set-base: func(uuid: string, name: string, value: f64) -> result<_, string>;
    add: func(uuid: string, name: string, modifier: modifier) -> result<_, string>;
    remove: func(uuid: string, name: string, id: string) -> result<_, string>;
}

/// Снимок и изменения инвентаря игрока; метаданные проверяет ядро.
interface inventory {
    enchant-with-levels: func(stack: item, levels: s32, treasure: bool, seed: s64) -> result<item, string>;
    record item { kind: string, count: u32, metadata: string }
    chest-create: func(size: u32, title: string) -> result<u32, string>;
    chest-set: func(handle: u32, slot: u32, stack: option<item>) -> result<_, string>;
    chest-snapshot: func(handle: u32) -> result<list<option<item>>, string>;
    chest-open: func(uuid: string, handle: u32) -> result<_, string>;
    chest-close: func(uuid: string) -> result<_, string>;
    chest-current: func(uuid: string) -> option<u32>;
    chest-release: func(handle: u32) -> result<_, string>;
    cursor: func(uuid: string) -> result<option<item>, string>;
    record view { kind: string, items: list<option<item>> }
    open-view: func(uuid: string) -> result<view, string>;
    snapshot: func(uuid: string) -> result<list<option<item>>, string>;
    selected: func(uuid: string) -> result<u32, string>;
    set: func(uuid: string, slot: u32, stack: option<item>) -> result<_, string>;
}

/// HTTPS выполняет ядро: без cookies, credentials, прокси и перенаправлений.
interface https {
    record response { status: u16, body: list<u8> }
    /// Только GET/POST: тело до 32 КиБ, ответ до 64 КиБ, срок 10 секунд.
    /// Хост должен быть объявлен плагином И разрешён администратором.
    start: func(method: string, url: string, body: list<u8>) -> result<u32, string>;
    /// none — запрос ещё идёт; готовый результат забирается ровно один раз.
    poll: func(handle: u32) -> result<option<response>, string>;
}

/// Только для `modules/` (доверенных). Песочница `plugins/` этого
/// интерфейса не даёт: плагин, который его просит, не загрузится.
///
/// Сюда же лягут глубокие зацепки — пакеты, механики, генерация мира.
interface privileged {
    /// Выполнить команду от имени консоли; ответ — текстом.
    run-console-command: func(command: string) -> string;

    /// Имена загруженных плагинов и модулей.
    loaded-plugins: func() -> list<string>;
}

/// Жизненный цикл.
interface lifecycle {
    /// Плагин загружен: регистрируй команды и задачи.
    enable: func();
    /// Плагин выгружается (выключение, `/plugman unload|reload`).
    disable: func();
}

/// То, что сервер вызывает у плагина. Обработчики событий вызываются на
/// том потоке, что применяет действие игрока (в начале такта, такт его
/// ждёт); задачи планировщика — на потоке такта.
interface events {
    use types.{player, block-pos, verdict, chat-result, sender, command-result};

    on-player-join: func(who: player);
    on-player-quit: func(who: player);

    /// Игрок написал в чат. Отменяемое и изменяемое.
    on-chat: func(who: player, message: string) -> chat-result;

    /// Игрок ломает блок (`block` — что стоит там сейчас). Отменяемое.
    on-block-break: func(who: player, pos: block-pos, block: string) -> verdict;

    /// Игрок ставит блок (`block` — что ставит). Отменяемое.
    on-block-place: func(who: player, pos: block-pos, block: string) -> verdict;

    /// Игрок ввёл любую команду (без косой черты); отмена — не выполнять.
    on-player-command: func(who: player, command-line: string) -> verdict;

    /// Вызвана команда этого плагина.
    on-command: func(caller: sender, name: string, args: list<string>) -> command-result;

    /// Пришло время задачи планировщика.
    on-task: func(task: u32);
}

/// Обычный плагин из `plugins/` — в песочнице.
world plugin {
    import types;
    import log;
    import server;
    import player;
    import presentation;
    import %world;
    import scheduler;
    import command;
    import attributes;
    import inventory;
    import entities;
    import storage;
    import https;

    export lifecycle;
    export events;
}

/// Доверенный модуль из `modules/`: всё то же и `privileged`.
world module {
    include plugin;
    import privileged;
}

/// Необязательный экспорт: старые компоненты продолжают работать без него.
interface completion {
    use types.{sender};
    on-tab-complete: func(caller: sender, name: string, args: list<string>) -> list<string>;
}

world bukkit-plugin {
    include plugin;
    export completion;
    export combat-events;
    export inventory-events;
    export player-events;
    export item-events;
    export trading-events;
    export generation-events;
    export native-events;
}

interface item-events {
    on-entity-death: func(who: option<player>, entity: string, keep: bool, drops: list<item>) -> list<item>;
    on-block-drop: func(who: player, pos: block-pos, data: string, items: list<string>) -> list<string>;
    on-ground-item: func(who: player, item: string, pickup: bool, remaining: s32) -> bool;
    use types.{block-pos};
    on-furnace: func(pos: block-pos, total: s32) -> s32;
    use inventory.{item};
    on-prepare-enchant: func(who: player, stack: item, properties: list<s32>) -> list<s32>;
    on-enchant: func(who: player, stack: item, output: item, button: u32, cost: s32, hint: string, level: s32) -> option<item>;
    on-food: func(who: player, level: s32, stack: option<item>) -> option<s32>;
    on-prepare-anvil: func(who: player, inputs: list<option<item>>, output: option<item>, cost: s32) -> s32;
    on-prepare-craft: func(who: player, grid: list<option<item>>, output: option<item>, repair: bool, table: bool) -> option<item>;

    /// Нажатие на сущность; slot — изменяемая ячейка стойки, если она есть.
    on-entity: func(who: player, target: string, hand: u32, slot: option<u32>) -> bool;

    use types.{player};
    /// 0 — смена выбранной ячейки, 1 — завершение еды/питья, 2 — обмен рук; true отменяет.
    on-item: func(who: player, kind: u32, slot: s32) -> bool;
    on-drag: func(who: player, handle: u32, slots: list<s32>) -> bool;
}

/// Необязательные события игроков: старым компонентам экспорт не нужен.
interface combat-events {
    use types.{player};
    /// Базовый урон до брони; none отменяет удар. Результат проверяется хозяином.
    on-damage: func(who: player, cause: string, damage: f64) -> option<f64>;
    on-damage-from: func(who: player, attacker: option<player>, cause: string, damage: f64) -> option<f64>;
    /// Уведомление о смерти до выпадения вещей; keep-inventory только для чтения.
    on-death: func(who: player, keep-inventory: bool);
}

world sdk-module {
    include module;
    export completion;
}

/// Только собственные окна компонента; true отменяет транзакцию до изменения вещей.
interface inventory-events {
    use types.{player};
    on-inventory: func(who: player, handle: u32, kind: u32, slot: s32, button: s32, mode: s32) -> bool;
}

/// Необязательные события перед принятием движения и использованием предмета.
interface player-events {
    use types.{player, location, block-pos};
    /// none возвращает клиента к прежнему месту; результат проходит проверку координат.
    on-move: func(who: player, destination: location, jump: bool) -> option<location>;
    on-respawn: func(who: player, destination: location, bed: bool, anchor: bool) -> location;
    /// 0 — разрешить, 1 — запретить блок, 2 — запретить предмет, 3 — оба.
    on-interact: func(who: player, action: u32, hand: u32, block: option<block-pos>, face: u32) -> u32;
}

/// Необязательные события нативной торговли; список результата: отмена, затем цены.
interface trading-events {
    use types.{player};
    on-trade: func(who: player, closed: bool, slots: list<string>, offers: list<string>) -> list<s32>;
}

/// Необязательные callbacks генерации: центральный чанк, сжатая палитра типов.
interface generation-events {
    use types.{block-pos};
    use inventory.{item};
    on-loot: func(pos: block-pos, slots: list<option<item>>) -> list<option<item>>;
    use types.{dimension};
    wants-population: func(dimension: dimension) -> bool;
    on-populate: func(dimension: dimension, x: s32, z: s32, seed: s64, palette: list<string>, runs: list<u32>) -> list<string>;
    on-world-init: func(dimension: dimension);
}

/// Дополнительные нативные события. Первый ответ — флаг отмены, затем поля события.
interface native-events {on-event: func(kind: u32, fields: list<string>) -> list<string>;}
