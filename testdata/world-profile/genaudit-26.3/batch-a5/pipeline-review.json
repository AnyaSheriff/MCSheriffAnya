  "pipeline": [
    {
      "stage": "depth",
      "wiki": "Depth grows by 1/128 per block downward; offset sets the zero plane.",
      "ours": "The zero plane is Relief.surface in block units; surface-y is the bias. No independent router depth/factor objects.",
      "finding": "The missing support is above this plane, so stronger positive-depth bias cannot repair it."
    },
    {
      "stage": "factor",
      "wiki": "A positive spline over continentalness, erosion, weirdness and PV controls the effect of the base 3D noise.",
      "ours": "wobble and rugged are additive displacement amplitudes. Positive E5 weirdness raises both the 2D plane and a separate fine 3D contribution; the enhanced amplitude also grows with continentalness.",
      "finding": "The documented offset/stretch separation is absent. The inflated far-inland E5 term creates high hills while near-coast savanna and beach height tails remain too low."
    },
    {
      "stage": "jaggedness",
      "wiki": "A separate 2D contribution creates small peaks; it is stronger in low-erosion, high-PV terrain with negative weirdness.",
      "ours": "A 2D detail ridge is applied at positive PV without a weirdness-sign gate. The E5 rugged term instead oscillates in 3D every 12 blocks.",
      "finding": "Peak profiles distinguish the missing sign-dependent response: frozen peaks are too high and jagged peaks too low in the sampled windows."
    },
    {
      "stage": "interpolation",
      "wiki": "Density can be interpolated between grid samples.",
      "ours": "Canonical 4x8x4 trilinear grid; fine terrain noise has vertical lattice scales of 12 and 6 blocks. The finest lattice spacing is smaller than the vertical grid spacing.",
      "finding": "At (200,-480), negative density Y128..168 is followed by positive density at Y176; the fine rugged contribution creates an upper stone island before carving. Large amplitude and short vertical correlation are demonstrated causes in our model. Undersampling is an additional risk, not proof of the sole cause; Perlin noise is not strictly band-limited."
    },
    {
      "stage": "squeeze",
      "wiki": "Clamp to [-1,1], then x/2-x^3/24.",
      "ours": "Absent; raw block-unit bias is interpolated.",
      "finding": "This monotone sign-preserving transform cannot create missing support at an already negative sampled node. Applying it at a different interpolation stage can move zero crossings, so it is not assumed to preserve generated block states."
    },
    {
      "stage": "top_slide",
      "wiki": "A height-dependent transition controls the top; the old slide density type was removed and replaced by gradient arithmetic.",
      "ours": "min(density, cap-y), with cap=259 at the diagnostic inland node.",
      "finding": "The cap is positive at Y160/Y192 and does not cause their negative density; it does not model a smooth top slide."
    },
    {
      "stage": "initial_density_without_jaggedness",
      "wiki": "Replaced by preliminary_surface_level in 1.21.9; renamed chunk_surface_level in 26.3 snapshot 10.",
      "ours": "The top of the same geometry grid is reused for column height and cave depth.",
      "finding": "The removed router entry must not be reintroduced as if it were current 26.3 final density."
    },
    {
      "stage": "peaks_and_valleys",
      "wiki": "PV folds weirdness symmetrically; weirdness sign still independently influences terrain shaping.",
      "ours": "1-abs(3*abs(W)-2) is correct; later relief responses omit part of the independent sign-dependent shaping.",
      "finding": "Changing the PV formula would be the wrong repair."
    }
  ],
